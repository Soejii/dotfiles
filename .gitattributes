# This dotfiles repo is checked out on Linux. Force LF on files that break with
# CRLF (bash scripts, systemd units, hypr/conf), regardless of the OS committing.
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.toml      text eol=lf
.bashrc     text eol=lf
