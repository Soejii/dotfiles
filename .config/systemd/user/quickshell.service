[Unit]
Description=Quickshell control drawer
Documentation=https://quickshell.org/docs/
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Give up rather than crash-loop forever on a QML syntax error.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/qs -p %h/.config/quickshell/shell.qml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
