[Unit]
Description=Send and verify measured Codex and OpenCode subscription tasks
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=900
ExecStart=%h/.local/bin/codex-ping.sh
Restart=on-failure
RestartSec=2min
