{
  "layer": "top",
  "position": "top",
  "height": 40,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "custom/warp",
    "custom/mudfish-ipv6",
    "custom/hypridle",
    "memory",
    "custom/volume",
    "battery",
    "custom/powermenu"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "/home/suji/.local/bin/ws-cycle prev",
    "on-scroll-down": "/home/suji/.local/bin/ws-cycle next",
    "all-outputs": false,
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "timezone": "Asia/Jakarta",
    "on-click": "~/.config/waybar/scripts/drawer.sh calendar",
    "tooltip-format": "<b>{:%A, %d %B %Y}</b>\n{calendar}",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#cdd6f4'><b>{}</b></span>",
        "days":     "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today":    "<span color='#f38ba8'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "interval": 5,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "⚠ Disconnected",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/drawer.sh network"
  },
  "memory": {
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/drawer.sh system",
    "format": "󰍛 {used} Gb / {total} Gb",
    "tooltip-format": "{percentage}% used"
  },
  "custom/volume": {
    "exec": "~/.config/waybar/scripts/audio-status.sh",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/drawer.sh audio",
    "on-click-right": "~/.config/waybar/scripts/audio-switch.sh",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && pkill -RTMIN+8 waybar",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && pkill -RTMIN+8 waybar",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && pkill -RTMIN+8 waybar"
  },
  "custom/warp": {
    "exec": "~/.config/waybar/scripts/warp-status.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/warp-toggle.sh"
  },
  "custom/mudfish-ipv6": {
    "exec": "~/.config/waybar/scripts/mudfish-ipv6-status.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 11,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/mudfish-ipv6-toggle.sh",
    "on-click-right": "/home/suji/.local/bin/mudfish-net-recover"
  },
  "custom/hypridle": {
    "exec": "~/.config/waybar/scripts/hypridle-status.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 10,
    "format": "{}",
    "tooltip": true,
    "on-click": "systemctl --user start hypridle.service && pkill -RTMIN+10 waybar"
  },
  "custom/bluetooth": {
    "format": "󰂯",
    "tooltip": false,
    "on-click": "blueman-manager"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "format": "{icon} {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-plugged": " {capacity}%",
    "tooltip-format": "{time} remaining",
    "interval": 30,
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ]
  },
  "custom/powermenu": {
    "format": "⏻",
    "tooltip": "Power Menu",
    "on-click": "~/.config/waybar/scripts/drawer.sh power"
  }
}
