{
  "layer": "top",
  "position": "top",
  "height": 40,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "custom/hypridle",
    "memory",
    "custom/volume",
    "bluetooth",
    "battery",
    "custom/powermenu"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-scroll-up": "/home/suji/.local/bin/ws-cycle prev",
    "on-scroll-down": "/home/suji/.local/bin/ws-cycle next",
    "all-outputs": false,
    "sort-by-number": true
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M:%S}",
    "timezone": "Asia/Jakarta",
    "on-click": "gsimplecal",
    "tooltip-format": "<b>{:%A, %d %B %Y}</b>\n{calendar}",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#cdd6f4'><b>{}</b></span>",
        "days":     "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today":    "<span color='#f38ba8'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "network": {
    "interval": 5,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "⚠ Disconnected",
    "tooltip": true,
    "on-click": "alacritty -e nmtui"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {used} Gb / {total} Gb",
    "tooltip-format": "{percentage}% used"
  },
  "custom/volume": {
    "exec": "~/.config/waybar/scripts/audio-status.sh --watch",
    "return-type": "json",
    "restart-interval": 5,
    "format": "{}",
    "tooltip": true,
    "on-click": "pavucontrol",
    "on-click-right": "~/.config/waybar/scripts/audio-switch.sh",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "custom/hypridle": {
    "exec": "~/.config/waybar/scripts/hypridle-status.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 10,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/hypridle-restart.sh"
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\nbluetooth {status}",
    "tooltip-format-connected": "{controller_alias}\nbluetooth {status}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
    "on-click": "blueman-manager"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "format": "{icon} {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "format-plugged": " {capacity}%",
    "tooltip-format": "{time} remaining",
    "interval": 30,
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ]
  },
  "custom/powermenu": {
    "format": "⏻",
    "tooltip": "Power Menu",
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  }
}
