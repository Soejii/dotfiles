#!/bin/bash
# Send escalating warnings as battery drains. State file ensures one warning per threshold.
STATE=/tmp/battery-warn.state

read -r level    < /sys/class/power_supply/BAT0/capacity
read -r status   < /sys/class/power_supply/BAT0/status
read -r ac_state < /sys/class/power_supply/ADP0/online

# Reset state when charging
if [ "$ac_state" = "1" ] || [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
    rm -f "$STATE"
    exit 0
fi

last=100
[ -f "$STATE" ] && read -r last < "$STATE"

notify() {
    notify-send "$@" 2>/dev/null
}

if [ "$level" -le 5 ] && [ "$last" -gt 5 ]; then
    notify -u critical -a battery -i battery-empty "Battery critical" "Suspending in 30 seconds. Plug in now to cancel."
    echo 5 > "$STATE"
    sleep 30
    # Re-check; user may have plugged in during the grace period
    if [ "$(cat /sys/class/power_supply/ADP0/online)" = "0" ]; then
        systemctl suspend
    fi
elif [ "$level" -le 15 ] && [ "$last" -gt 15 ]; then
    notify -u critical -a battery -i battery-caution "Battery very low" "${level}% remaining. Plug in soon."
    echo 15 > "$STATE"
elif [ "$level" -le 25 ] && [ "$last" -gt 25 ]; then
    notify -u normal -a battery -i battery-low "Battery low" "${level}% remaining."
    echo 25 > "$STATE"
fi
