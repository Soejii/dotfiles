#!/bin/bash
# Cycle to the next/previous workspace on the focused monitor.
# Usage: ws-cycle next | ws-cycle prev
#
# The monitor's block of ten comes from the live arrangement via
# `hypr-display focused`, so this follows the Display pane instead of assuming
# DP-1 owns 1-10.

DIRECTION=$1
read -r MONITOR BASE < <(/home/suji/.local/bin/hypr-display focused)
LO=$((BASE + 1))
HI=$((BASE + 10))

CURRENT=$(hyprctl activeworkspace -j | python3 -c "import json,sys; print(json.load(sys.stdin)['id'])")

# Get all existing workspace IDs in this monitor's range, sorted
EXISTING=$(hyprctl workspaces -j | python3 -c "
import json, sys
wss = json.load(sys.stdin)
ids = sorted(ws['id'] for ws in wss if $LO <= ws['id'] <= $HI)
print(' '.join(str(i) for i in ids))
")

# Build list: existing workspaces + the next empty one at the end
IDS=($EXISTING)
COUNT=${#IDS[@]}

if [ "$COUNT" -eq 0 ]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = $LO })"
    exit 0
fi

# Find current index
CURRENT_IDX=-1
for i in "${!IDS[@]}"; do
    if [ "${IDS[$i]}" -eq "$CURRENT" ]; then
        CURRENT_IDX=$i
        break
    fi
done

if [ "$DIRECTION" = "next" ]; then
    NEXT_IDX=$((CURRENT_IDX + 1))
    if [ "$NEXT_IDX" -ge "$COUNT" ]; then
        # Wrap to first
        NEXT_IDX=0
    fi
else
    NEXT_IDX=$((CURRENT_IDX - 1))
    if [ "$NEXT_IDX" -lt 0 ]; then
        # Wrap to last
        NEXT_IDX=$((COUNT - 1))
    fi
fi

TARGET=${IDS[$NEXT_IDX]}
hyprctl dispatch "hl.dsp.focus({ workspace = $TARGET })"

# Rename for display, so every monitor's workspaces read 1-10 in the waybar
if [ "$BASE" -gt 0 ]; then
    DISPLAY_NUM=$((TARGET - BASE))
    hyprctl dispatch "hl.dsp.workspace.rename({ workspace = $TARGET, name = \"$DISPLAY_NUM\" })" 2>/dev/null
fi
