#!/bin/bash
# Move the active window to the Nth workspace (1-10) on the focused monitor,
# then follow it there. Block selection works exactly as in ws-switch: it comes
# from the live arrangement via `hypr-display focused`, never from a hardcoded
# connector name.

N=$1
read -r MONITOR BASE < <(/home/suji/.local/bin/hypr-display focused)
WS=$((BASE + N))

hyprctl dispatch "hl.dsp.window.move({ workspace = $WS, follow = false })"
hyprctl dispatch "hl.dsp.focus({ workspace = $WS })"

if [ "$BASE" -gt 0 ]; then
    hyprctl dispatch "hl.dsp.workspace.rename({ workspace = $WS, name = \"$N\" })" 2>/dev/null
fi
