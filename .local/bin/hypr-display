#!/usr/bin/env python3
"""Owns the Hyprland monitor arrangement: which output is main (the one in
front of you), where every other output sits around it in 2D, and which ones
mirror main.

The arrangement lives in display-layout.json and is compiled to
display-layout.gen.lua, which hyprland.lua dofiles. That is the whole point of
the generated file: a change made here IS the config, so it survives
`hyprctl reload` and a restart exactly as if hyprland.lua had been edited by
hand. Monitor modes are deliberately NOT managed here; edit the "mode" field in
display-layout.json if a refresh rate ever needs changing.

Placement is RELATIVE (layout v2): every monitor except main records which
neighbour it is attached to, on which side, and how it is aligned along that
edge, e.g. {"of": "HDMI-A-1", "side": "below", "align": "center"}. Relative, not
absolute, so a layout survives a monitor changing resolution or being
unplugged: anything attached to an absent monitor re-attaches, same side, to
that monitor's own anchor. The Display pane drags a monitor to an absolute drop
point; `move` snaps it to the nearest free edge and re-derives the whole tree
from the resulting geometry, which is also why the tree can never contain a
cycle.

A monitor marked "standby" in the layout (the Redmi's headless PHONE output,
which only exists while Moonlight streams it) is planned even while it is
absent: its position and workspace block stay reserved, so it can appear and
disappear without a config apply and without renumbering anyone else.

Mirroring an output takes its block of ten away, so its workspaces are folded
onto the end of main's block and remembered in display-merged.json; un-mirroring
reads that back and puts them where they were. The record is the whole trick:
the moment a workspace is folded in, nothing in Hyprland's own state still says
which monitor produced it.

Workspace ranges follow the arrangement, never the connector name: main owns
1-10, then the monitors in main's row from the right of it outwards, then the
ones on its left, then everything above or below, top to bottom. Those bases are
written to display-workspaces.json, which ws-switch, ws-move and ws-cycle read
so Mod+1..0 keeps meaning "this monitor's block".

Usage:
  hypr-display state                  JSON for the drawer's Display pane
  hypr-display move <output> <x> <y>  drop a monitor at a logical point; snaps
  hypr-display set <output> <slot>    slot: main | mirror | extend | left | right
  hypr-display apply                  recompile and reload, changing nothing
  hypr-display focused                "<monitor> <workspace base>", for ws-*
"""

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config", "hypr")
LAYOUT = os.path.join(CFG, "display-layout.json")
GEN_LUA = os.path.join(CFG, "display-layout.gen.lua")
WS_MAP = os.path.join(CFG, "display-workspaces.json")
MERGED = os.path.join(CFG, "display-merged.json")
LOCK = os.path.join(CFG, ".display-layout.lock")
TRACE = os.path.expanduser("~/.cache/hypr-display.log")

HYPRCTL = shutil.which("hyprctl") or "/usr/bin/hyprctl"

# Everything that reaches the generated Lua as a bare string is checked against
# this first, so a weird EDID-derived name can never break out of its quotes.
SAFE = re.compile(r"^[A-Za-z0-9@._:+-]+$")

SLOTS = ("main", "mirror", "extend", "left", "right")
SIDES = ("right", "left", "below", "above")

# Two monitors must share at least this much edge to count as attached, so the
# cursor always has a real doorway between them rather than a corner.
MIN_SHARED = 64
# How close (as a fraction of the shorter edge) a drop has to land to a start,
# centre or end alignment, or to another monitor's edge, before it snaps to it.
# Generous on purpose: in the pane one screen pixel is ~16 logical ones.
SNAP = 0.25


def trace(label):
    """Append a snapshot of every workspace to ~/.cache/hypr-display.log.

    A layout change is a sequence of asynchronous dispatches, and the settled
    state looks identical whether or not something went wrong halfway through,
    so the only way to see a fault of that kind is to record each step as it
    happens."""
    try:
        act = hypr_json("activeworkspace")
        act_id = act.get("id") if isinstance(act, dict) else None
        rows = " ".join(
            f"{'*' if w.get('id') == act_id else ''}{w.get('id')}:{w.get('name')}"
            f"@{w.get('monitor')}{'' if w.get('windows') else '(EMPTY)'}"
            for w in sorted(hypr_json("workspaces"), key=lambda w: w.get("id") or 0))
        os.makedirs(os.path.dirname(TRACE), exist_ok=True)
        if os.path.exists(TRACE) and os.path.getsize(TRACE) > 200_000:
            os.remove(TRACE)
        with open(TRACE, "a") as fh:
            fh.write(f"{time.strftime('%H:%M:%S')}.{int(time.time() * 1000) % 1000:03d} "
                     f"[{os.getpid()}] {label:<18} {rows}\n")
    except OSError:
        pass


def resync_waybar():
    """Renumbering a workspace with change_id does not emit the create/destroy
    events waybar's hyprland/workspaces module listens for, so its buttons keep
    the ids the workspaces had before the merge. Those ghosts are worse than
    cosmetic: clicking one asks Hyprland to activate a workspace that no longer
    exists, and Hyprland obligingly creates it, which is where the empty
    workspaces came from. SIGUSR2 makes waybar reload and re-read the truth."""
    subprocess.run([shutil.which("pkill") or "/usr/bin/pkill", "-SIGUSR2", "waybar"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_watch(seconds):
    """Keep tracing after the run has finished. Everything this tool does is an
    asynchronous dispatch, so a workspace conjured by one that lands late shows
    up after the last step has already logged a clean state."""
    end = time.time() + float(seconds)
    last = None
    while time.time() < end:
        rows = tuple(sorted((w.get("id"), w.get("name"), w.get("monitor"), bool(w.get("windows")))
                            for w in hypr_json("workspaces")))
        rows = (rows, (hypr_json("activeworkspace") or {}).get("id"))
        if rows != last:
            trace("after")
            last = rows
        time.sleep(0.2)


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def safe(value, what):
    if not SAFE.match(str(value)):
        die(f"refusing to write unsafe {what}: {value!r}")
    return str(value)


def hypr(*args, capture=True):
    cmd = [HYPRCTL] + list(args)
    if not capture:
        return subprocess.run(cmd, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def hypr_json(*args):
    try:
        return json.loads(hypr(*args, "-j") or "[]")
    except json.JSONDecodeError:
        return []


def dispatch(expr):
    subprocess.run([HYPRCTL, "dispatch", expr],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------------- live state

def live_monitors():
    """Connector name -> what Hyprland currently reports, with the logical size
    already worked out (mode divided by scale, axes swapped for a rotated
    output) because that, not the pixel mode, is what positions are measured in."""
    out = {}
    for m in hypr_json("monitors", "all"):
        name = (m.get("name") or "").strip()
        if not name:
            continue
        scale = float(m.get("scale") or 1) or 1.0
        w = int(m.get("width") or 0)
        h = int(m.get("height") or 0)
        if int(m.get("transform") or 0) in (1, 3, 5, 7):
            w, h = h, w
        out[name] = {
            "name": name,
            "make": (m.get("make") or "").strip(),
            "model": (m.get("model") or "").strip(),
            "description": (m.get("description") or "").strip(),
            "pxWidth": int(m.get("width") or 0),
            "pxHeight": int(m.get("height") or 0),
            "refresh": float(m.get("refreshRate") or 0),
            "logicalWidth": int(round(w / scale)),
            "logicalHeight": int(round(h / scale)),
            "x": int(m.get("x") or 0),
            "y": int(m.get("y") or 0),
            "disabled": bool(m.get("disabled")),
            "mirrorOf": (m.get("mirrorOf") or "none"),
        }
    return out


def usable(live, name):
    m = live.get(name)
    return bool(m) and not m["disabled"] and m["logicalWidth"] > 0


# -------------------------------------------------------------- layout state

def default_entry():
    return {"mode": "preferred", "scale": 1}


def load_layout(live):
    try:
        with open(LAYOUT) as fh:
            layout = json.load(fh)
    except (OSError, json.JSONDecodeError):
        layout = {}
    layout.setdefault("monitors", {})
    layout.setdefault("mirrors", [])
    layout.setdefault("place", {})
    if "order" in layout:
        layout = migrate_v1(layout, live)
    layout["version"] = 2
    return normalise(layout, live)


def migrate_v1(layout, live):
    """v1 kept one left-to-right row at y = 0. Rebuild exactly that geometry and
    derive v2's relative placements from it, so the first run looks identical."""
    order = [n for n in layout.pop("order") if n not in layout["mirrors"]]
    geom, x = {}, 0
    for name in order:
        if usable(live, name):
            w, h = live[name]["logicalWidth"], live[name]["logicalHeight"]
            geom[name] = (x, 0, w, h)
            x += w
    main = layout.get("main")
    root = main if main in geom else next(iter(geom), None)
    if root:
        layout["place"].update(derive_places(geom, root))
    # Offline ones keep their spot in the chain: right of whoever preceded them.
    for i, name in enumerate(order):
        if name not in geom and name != root:
            prev = order[i - 1] if i else root
            if prev and prev != name:
                layout["place"][name] = {"of": prev, "side": "right", "align": "start"}
    return layout


def normalise(layout, live):
    """Fold in anything newly plugged in, drop contradictions, remember each
    monitor's logical size (a standby monitor is planned from it while absent),
    and guarantee exactly one main monitor that can actually show something."""
    mons = layout["monitors"]
    for name in sorted(live, key=lambda n: live[n]["x"]):
        if name not in mons:
            mons[name] = default_entry()
        if usable(live, name) and not (mons[name].get("standby") and configured_size(mons[name])):
            mons[name]["size"] = [live[name]["logicalWidth"], live[name]["logicalHeight"]]

    layout["mirrors"] = [n for n in layout["mirrors"] if n in mons]

    main = layout.get("main")
    if main not in mons or not usable(live, main) or main in layout["mirrors"]:
        candidates = [n for n in mons if usable(live, n) and n not in layout["mirrors"]]
        main = candidates[0] if candidates else next(iter(mons), None)
    layout["main"] = main
    layout["mirrors"] = [n for n in layout["mirrors"] if n != main]

    # A monitor seen for the first time goes to the right of main; the overlap
    # push in resolve() then walks it out past whatever is already there.
    for name in mons:
        if name != main and name not in layout["place"] and main:
            layout["place"][name] = {"of": main, "side": "right", "align": "start"}
    layout["place"].pop(main, None)
    return layout


def save_layout(layout):
    write_atomic(LAYOUT, json.dumps(layout, indent=2) + "\n")


def write_atomic(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


# ------------------------------------------------------------------ geometry
# A rect is (x, y, w, h) in logical pixels, which is what Hyprland positions in.

def span_overlap(a0, a1, b0, b1):
    return min(a1, b1) - max(a0, b0)


def rects_overlap(r, q):
    return (span_overlap(r[0], r[0] + r[2], q[0], q[0] + q[2]) > 0 and
            span_overlap(r[1], r[1] + r[3], q[1], q[1] + q[3]) > 0)


def along(a0, alen, blen, align):
    """Offset along the shared edge. "align" is start/center/end or a number of
    pixels from the anchor's start edge."""
    if align == "end":
        return a0 + alen - blen
    if align == "center":
        return a0 + (alen - blen) // 2
    if align == "start":
        return a0
    try:
        return a0 + int(align)
    except (TypeError, ValueError):
        return a0


def attach(anchor, size, side, align):
    ax, ay, aw, ah = anchor
    w, h = size
    if side in ("right", "left"):
        x = ax + aw if side == "right" else ax - w
        return (x, along(ay, ah, h, align), w, h)
    y = ay + ah if side == "below" else ay - h
    return (along(ax, aw, w, align), y, w, h)


def align_name(off, alen, blen):
    if off == 0:
        return "start"
    if off == (alen - blen) // 2:
        return "center"
    if off == alen - blen:
        return "end"
    return int(off)


def relation(anchor, rect):
    """How `rect` is attached to `anchor`, if it touches one of its edges."""
    ax, ay, aw, ah = anchor
    x, y, w, h = rect
    if span_overlap(y, y + h, ay, ay + ah) > 0:
        if x == ax + aw:
            return {"side": "right", "align": align_name(y - ay, ah, h)}
        if x + w == ax:
            return {"side": "left", "align": align_name(y - ay, ah, h)}
    if span_overlap(x, x + w, ax, ax + aw) > 0:
        if y == ay + ah:
            return {"side": "below", "align": align_name(x - ax, aw, w)}
        if y + h == ay:
            return {"side": "above", "align": align_name(x - ax, aw, w)}
    return None


def loose_relation(anchor, rect):
    """For a rect that touches nothing: attach it on the side it mostly lies on,
    keeping at least MIN_SHARED of edge in common. Resolving it closes the gap."""
    ax, ay, aw, ah = anchor
    x, y, w, h = rect
    dx = (x + w / 2) - (ax + aw / 2)
    dy = (y + h / 2) - (ay + ah / 2)
    if abs(dx) / (aw + w) >= abs(dy) / (ah + h):
        side, off, alen, blen = ("right" if dx > 0 else "left"), y - ay, ah, h
    else:
        side, off, alen, blen = ("below" if dy > 0 else "above"), x - ax, aw, w
    shared = min(MIN_SHARED, alen, blen)
    off = max(shared - blen, min(off, alen - shared))
    return {"side": side, "align": align_name(off, alen, blen)}


def derive_places(geom, root):
    """Rebuild the relative placement tree from absolute geometry, rooted at
    `root`. Deterministic, and a tree by construction, so no cycles."""
    visited, places = [root], {}
    remaining = [n for n in geom if n != root]
    while remaining:
        found = None
        for n in sorted(remaining, key=lambda n: (geom[n][1], geom[n][0], n)):
            for a in visited:
                rel = relation(geom[a], geom[n])
                if rel:
                    found = (n, a, rel)
                    break
            if found:
                break
        if not found:
            def gap(pair):
                n, a = pair
                R, A = geom[n], geom[a]
                return ((R[0] + R[2] / 2) - (A[0] + A[2] / 2)) ** 2 + \
                       ((R[1] + R[3] / 2) - (A[1] + A[3] / 2)) ** 2
            n, a = min(((n, a) for n in remaining for a in visited), key=gap)
            found = (n, a, loose_relation(geom[a], geom[n]))
        n, a, rel = found
        rel["of"] = a
        places[n] = rel
        visited.append(n)
        remaining.remove(n)
    return places


def push_clear(rect, side, geom):
    """Slide a rect along its attachment direction until it overlaps nothing."""
    for _ in range(64):
        hit = next((q for q in geom.values() if rects_overlap(rect, q)), None)
        if hit is None:
            break
        x, y, w, h = rect
        if side == "right":
            x = hit[0] + hit[2]
        elif side == "left":
            x = hit[0] - w
        elif side == "below":
            y = hit[1] + hit[3]
        else:
            y = hit[1] - h
        rect = (x, y, w, h)
    return rect


def configured_size(entry):
    """Logical size implied by an explicit "WxH@R" mode and the scale, or None.
    Standby outputs are sized from this rather than from Hyprland, because a
    freshly created headless output briefly reports a default mode, and planning
    from that snapshot once put the phone 160px off centre."""
    m = re.match(r"^(\d+)x(\d+)", str(entry.get("mode") or ""))
    if not m:
        return None
    try:
        scale = float(entry.get("scale", 1)) or 1.0
    except (TypeError, ValueError):
        scale = 1.0
    return (int(round(int(m.group(1)) / scale)), int(round(int(m.group(2)) / scale)))


def planned_sizes(layout, live):
    """Every output that gets a position: connected, non-mirrored ones, plus
    standby ones even while absent (sized from the last time they were seen)."""
    out = {}
    for name, entry in layout["monitors"].items():
        if name in layout["mirrors"]:
            continue
        if entry.get("standby") and configured_size(entry):
            out[name] = configured_size(entry)
        elif usable(live, name):
            out[name] = (live[name]["logicalWidth"], live[name]["logicalHeight"])
        elif entry.get("standby") and entry.get("size"):
            w, h = entry["size"]
            out[name] = (int(w), int(h))
    return out


def resolve(layout, sizes, root):
    places = layout["place"]
    geom = {root: (0, 0) + sizes[root]}
    pending = [n for n in sizes if n != root]

    def anchor_of(name):
        rel = places.get(name)
        if not rel:
            return None, None
        a, seen = rel.get("of"), {name}
        # Attached to something absent or mirrored: re-attach, same side and
        # alignment, to that monitor's own anchor, and so on up the chain.
        while a not in sizes and a in places and a not in seen:
            seen.add(a)
            a = places[a].get("of")
        if a not in sizes or a == name:
            a = root
        return a, rel

    for _ in range(len(pending) + 1):
        progressed = False
        for name in list(pending):
            a, rel = anchor_of(name)
            if rel is None or a not in geom:
                continue
            side = rel.get("side") if rel.get("side") in SIDES else "right"
            rect = attach(geom[a], sizes[name], side, rel.get("align", "start"))
            geom[name] = push_clear(rect, side, geom)
            pending.remove(name)
            progressed = True
        if not progressed:
            break
    for name in pending:                      # nothing usable to hang it off
        right = max(geom.values(), key=lambda r: r[0] + r[2])
        rect = (right[0] + right[2], right[1]) + sizes[name]
        geom[name] = push_clear(rect, "right", geom)

    # Top-left of the whole arrangement at 0,0, like the old row layout.
    mx = min(r[0] for r in geom.values())
    my = min(r[1] for r in geom.values())
    return {n: (r[0] - mx, r[1] - my, r[2], r[3]) for n, r in geom.items()}


def in_main_row(name, places, main):
    """True if `name` hangs off main through left/right attachments only. Judged
    from the attachment chain, not from overlapping heights: DP-1 is taller than
    HDMI-A-1, so the phone under HDMI-A-1 overlaps DP-1's height but is plainly
    not in its row."""
    seen = set()
    while name != main:
        rel = places.get(name)
        if not rel or name in seen or rel.get("side") not in ("left", "right"):
            return False
        seen.add(name)
        name = rel.get("of")
    return True


def workspace_bases(geom, main, places):
    """Main 1-10; then main's row, right of it outwards, then left of it
    outwards (the old rule, unchanged for a single row); then everything above
    or below, top to bottom, left to right."""
    if main not in geom:
        return {}
    mx, _my, mw, _mh = geom[main]
    mcx = mx + mw / 2
    others = [n for n in geom if n != main]
    row = [n for n in others if in_main_row(n, places, main)]
    right = sorted((n for n in row if geom[n][0] + geom[n][2] / 2 > mcx), key=lambda n: geom[n][0])
    left = sorted((n for n in row if geom[n][0] + geom[n][2] / 2 <= mcx), key=lambda n: -geom[n][0])
    rest = sorted((n for n in others if n not in row), key=lambda n: (geom[n][1], geom[n][0]))
    return {name: 10 * i for i, name in enumerate([main] + right + left + rest)}


def compute(layout, live):
    sizes = planned_sizes(layout, live)
    main = layout["main"] if layout["main"] in sizes else next(iter(sizes), None)
    if not main:
        return {}, None, {}
    geom = resolve(layout, sizes, main)

    # Blocks are numbered over EVERY monitor we know a size for, as if all of
    # them were extended, so a mirrored or unplugged monitor keeps its block
    # reserved. Numbering only the visible ones let the phone slide into
    # HDMI-A-1's 11-20 while HDMI-A-1 was mirrored, which parked HDMI-A-1's
    # workspaces on the phone instead of folding them onto main. The map itself
    # only lists outputs that are actually shown, so the fold still happens.
    every = dict(sizes)
    for name, entry in layout["monitors"].items():
        if name not in every and entry.get("size"):
            every[name] = tuple(int(v) for v in entry["size"])
    numbering = workspace_bases(resolve(layout, every, main), main, layout["place"])
    return geom, main, {n: b for n, b in numbering.items() if n in geom}


def descendants(places, name):
    """Every monitor whose anchor chain runs through `name`: the ones that are
    carried along when `name` moves."""
    out, grew = set(), True
    while grew:
        grew = False
        for n, rel in places.items():
            if n not in out and n != name and rel.get("of") in out | {name}:
                out.add(n)
                grew = True
    return out


def snap_drop(x, y, w, h, others):
    """Best attachment for a monitor dropped with its top-left at (x, y): the
    closest free spot on any edge of any other monitor, snapped to start,
    centre or end when the drop lands near one."""
    best = None
    for anchor, A in others.items():
        ax, ay, aw, ah = A
        for side in SIDES:
            if side in ("right", "left"):
                fixed = ax + aw if side == "right" else ax - w
                a0, alen, blen, want = ay, ah, h, y
            else:
                fixed = ay + ah if side == "below" else ay - h
                a0, alen, blen, want = ax, aw, w, x
            shared = min(MIN_SHARED, alen, blen)
            pos = max(a0 + shared - blen, min(want, a0 + alen - shared))
            targets = [a0, a0 + (alen - blen) // 2, a0 + alen - blen]
            # Also line up with the other monitors' edges, so a drop into the
            # corner under a neighbour meets that neighbour's edge exactly.
            for q in others.values():
                q0, qlen = (q[1], q[3]) if side in ("right", "left") else (q[0], q[2])
                targets += [q0, q0 + qlen, q0 - blen, q0 + qlen - blen]
            near = min(targets, key=lambda t: abs(t - pos))
            if abs(near - pos) <= SNAP * min(alen, blen):
                pos = near
            cand = (fixed, pos, w, h) if side in ("right", "left") else (pos, fixed, w, h)
            if any(rects_overlap(cand, q) for q in others.values()):
                continue
            d = (cand[0] - x) ** 2 + (cand[1] - y) ** 2
            if best is None or d < best[0]:
                best = (d, cand, anchor)
    return (best[1], best[2]) if best else (None, None)


# ----------------------------------------------------------------- rendering

def fmt_scale(value):
    try:
        value = float(value)
    except (TypeError, ValueError):
        return "1"
    return str(int(value)) if value.is_integer() else repr(round(value, 6))


def monitor_line(layout, name, position, mirror=None):
    entry = layout["monitors"].get(name, default_entry())
    parts = [
        f'output = "{safe(name, "output name")}"',
        f'mode = "{safe(entry.get("mode") or "preferred", "mode")}"',
        f'position = "{safe(position, "position")}"',
        f'scale = {fmt_scale(entry.get("scale", 1))}',
    ]
    if mirror:
        parts.append(f'mirror = "{safe(mirror, "mirror source")}"')
    return "hl.monitor({ " + ", ".join(parts) + " })"


def render_lua(layout, live, geom, main, bases):
    out = [
        "-- GENERATED by hypr-display. Do not edit by hand: the next layout",
        "-- change overwrites it. Edit ~/.config/hypr/display-layout.json, or",
        "-- use the Display pane in the Quickshell drawer.",
        "--",
        f"-- main (centre) output: {main or 'none'}",
        "",
    ]
    for name, (x, y, _w, _h) in sorted(geom.items(), key=lambda kv: (kv[1][1], kv[1][0])):
        line = monitor_line(layout, name, f"{x}x{y}")
        if not usable(live, name):
            line += "  -- standby: applies whenever it appears"
        out.append(line)
    for name in layout["mirrors"]:
        if name in live and main:
            out.append(monitor_line(layout, name, "auto", mirror=main))

    out.append("")
    out.append("-- Workspace blocks follow the arrangement, not the connector: main owns")
    out.append("-- 1-10, then its row rightwards, then leftwards, then above/below.")
    for name, base in sorted(bases.items(), key=lambda kv: kv[1]):
        for n in range(1, 11):
            ws = base + n
            tail = ", default = true" if n == 1 else ""
            out.append(f'hl.workspace_rule({{ workspace = "{ws}", '
                       f'monitor = "{safe(name, "output name")}"{tail} }})')
    return "\n".join(out) + "\n"


# ------------------------------------------------------------------- applying

def load_merged():
    try:
        with open(MERGED) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_merged(data):
    if data:
        write_atomic(MERGED, json.dumps(data, indent=2) + "\n")
        return
    try:
        os.remove(MERGED)
    except OSError:
        pass


def read_bases():
    try:
        with open(WS_MAP) as fh:
            return {k: int(v) for k, v in json.load(fh).items()}
    except (OSError, ValueError, TypeError, AttributeError, json.JSONDecodeError):
        return {}


def owner_map(bases):
    """Workspace id -> the monitor whose block of ten contains it."""
    return {base + n: name for name, base in bases.items() for n in range(1, 11)}


def live_workspaces():
    out = {}
    for ws in hypr_json("workspaces"):
        wid = int(ws.get("id") or 0)
        if wid >= 1:
            out[wid] = int(ws.get("windows") or 0)
    return out


def first_free(base, taken):
    for n in range(1, 11):
        if base + n not in taken:
            return base + n
    return None


def apply_renames(renames, settle=0.25):
    """Naming is done in a second pass, after every id has changed. change_id
    renames the workspace after itself, so a rename issued immediately after its
    own change_id can be undone by it. `settle` is the wait for those id changes
    to land, and is only needed when nothing else has happened in between."""
    if not renames:
        return
    time.sleep(settle)
    for wid, name in renames:
        dispatch(f'hl.dsp.workspace.rename({{ workspace = {wid}, name = "{name}" }})')
    time.sleep(0.15)


def park_id(base, taken):
    """Somewhere to shove an empty placeholder. The top free slot of its own
    block is preferred, because it is on screen for a moment and an empty
    workspace numbered inside the block reads as ordinary; an id like 900 does
    not. Falls back outside the blocks only if the block is full."""
    for n in range(10, 0, -1):
        if base + n not in taken:
            return base + n
    n = 900
    while n in taken:
        n += 1
    return n


def fold_workspaces(old_bases, new_bases, main):
    """Fold workspaces whose block is about to disappear onto the end of main's.

    Called BEFORE the new config is applied, while the output losing its block
    still exists. The ordering is the whole point: renumber after the reload and
    the waybar shows that monitor's 1, 2, 3 sitting next to main's own 1, 2 for
    as long as the reload and the renumbering take, which reads as a bug.

    Returns {old id: new id} so the caller can follow focus through it."""
    if main not in new_bases:
        return {}
    merged = load_merged()
    counts = live_workspaces()
    taken = set(counts)
    new_owner = owner_map(new_bases)
    old_owner = owner_map(old_bases)
    main_base = new_bases[main]
    renames, moves = [], {}

    for wid in sorted(w for w in counts if w not in new_owner):
        if counts[wid] < 1:
            continue                          # empty: Hyprland drops it by itself
        target = first_free(main_base, taken)
        if target is None:
            break                             # block full, leave it where it is
        taken.discard(wid)
        taken.add(target)
        if wid != target:
            dispatch(f"hl.dsp.workspace.change_id({{ workspace = {wid}, id = {target} }})")
            moves[wid] = target
        renames.append((target, str(target - main_base)))
        source = old_owner.get(wid)
        if source and source != main:
            merged.setdefault(source, []).append(
                {"slot": wid - old_bases.get(source, 0), "at": target})

    # Saved before the renames: those sleep, and a run killed in that window
    # would otherwise leave the workspaces folded in with nothing recording
    # where they came from, making the un-mirror impossible.
    save_merged(merged)
    apply_renames(renames)
    return moves


def unfold_workspaces(new_bases):
    """Hand each block back to the output that has it again, reading where every
    workspace came from out of display-merged.json. Runs AFTER the reload,
    because the monitor it is handing back to has to exist first.

    What is stored per workspace is its SLOT (1-10) and its source monitor, not
    its old id, so the round trip still lands correctly if the arrangement moved
    while it was folded in.

    Renaming is left to the caller: a handed-back workspace takes a name main
    already uses, so it has to reach its own monitor before it is renamed or the
    waybar briefly shows main holding two 1s and two 2s."""
    merged = load_merged()
    if not merged:
        return {}, []
    counts = live_workspaces()
    taken = set(counts)
    renames, moves = [], {}

    for mon in [m for m in merged if m in new_bases]:
        base = new_bases[mon]
        for rec in sorted(merged[mon], key=lambda r: int(r["slot"])):
            at = int(rec["at"])
            if at not in taken:
                continue                      # closed while it was folded in
            target = base + int(rec["slot"])
            if target != at and target in taken:
                if counts.get(target, 0) == 0:
                    # The compositor gives an output that has just got its block
                    # back an empty default workspace, and it lands on exactly
                    # the slot the first workspace is coming home to. Shove it
                    # aside rather than letting it push the whole block along.
                    parked = park_id(base, taken)
                    dispatch(f"hl.dsp.workspace.change_id({{ workspace = {target}, id = {parked} }})")
                    taken.discard(target)
                    taken.add(parked)
                    counts[parked] = 0
                    renames.append((parked, str(parked - base)))
                else:
                    target = first_free(base, taken)
                    if target is None:
                        continue
            taken.discard(at)
            taken.add(target)
            if at != target:
                dispatch(f"hl.dsp.workspace.change_id({{ workspace = {at}, id = {target} }})")
                moves[at] = target
            renames.append((target, str(target - base)))
        del merged[mon]

    save_merged(merged)
    return moves, renames


def rehome_workspaces(bases):
    """Workspace rules only bind at creation time, so an existing workspace
    stays put when its block changes owner. Walk them once and move the ones
    that now belong somewhere else. Focus is the caller's business."""
    owner = owner_map(bases)
    # A standby output has a block even while it is absent; its workspaces wait
    # wherever Hyprland parked them until it comes back.
    present = {m.get("name") for m in hypr_json("monitors")}
    for ws in hypr_json("workspaces"):
        wid = int(ws.get("id") or 0)
        if wid < 1:
            continue
        target = owner.get(wid)
        if target and target in present and ws.get("monitor") != target:
            dispatch(f'hl.dsp.workspace.move({{ workspace = {wid}, monitor = "{target}" }})')


def active_workspace_id():
    active = hypr_json("activeworkspace")
    wid = active.get("id") if isinstance(active, dict) else None
    return wid if isinstance(wid, int) and wid >= 1 else None


def tidy_placeholders(bases):
    """Evict the empty default workspaces the compositor leaves on an output
    that has just got its block back. They are that monitor's active workspace,
    so nothing hides them and they never get collected: showing a real
    workspace there instead is what makes them go away."""
    counts = live_workspaces()
    for mon in hypr_json("monitors"):
        name = mon.get("name")
        if name not in bases:
            continue
        active = mon.get("activeWorkspace") or {}
        active_id = int(active.get("id") or 0)
        if counts.get(active_id, 1) != 0:
            continue
        base = bases[name]
        real = [base + n for n in range(1, 11) if counts.get(base + n, 0) > 0]
        if real:
            dispatch(f"hl.dsp.focus({{ workspace = {real[0]} }})")
        elif not base < active_id <= base + 10:
            # Empty AND outside its own block: left over from a renumbering (the
            # phone sat on an empty 31 after its block went 31-40 and back).
            # Its block's first workspace is created on it by the workspace rule.
            dispatch(f"hl.dsp.focus({{ workspace = {base + 1} }})")


def restore_focus(wid):
    # Focusing a workspace that no longer exists CREATES it, which is how an
    # empty one gets left behind after the merge renumbers things.
    if wid is not None and wid in live_workspaces():
        dispatch(f"hl.dsp.focus({{ workspace = {wid} }})")


def apply(layout, live, force=False):
    old_bases = read_bases()          # read before the map is overwritten below
    geom, main, bases = compute(layout, live)
    lua = render_lua(layout, live, geom, main, bases)
    ws_map = json.dumps(bases, indent=2) + "\n"

    unchanged = (read_or_none(GEN_LUA) == lua and read_or_none(WS_MAP) == ws_map)
    write_atomic(GEN_LUA, lua)
    write_atomic(WS_MAP, ws_map)
    if unchanged and not force:
        return False

    was_on = active_workspace_id()
    trace("start")

    # Fold first, while the output about to lose its block is still there, so
    # the merged workspaces are already on main before anything is reconfigured.
    folded = fold_workspaces(old_bases, bases, main)
    rehome_workspaces(bases)
    trace("folded")

    hypr("reload", capture=False)
    time.sleep(0.4)        # let the outputs settle before moving anything onto them
    rehome_workspaces(bases)
    trace("reloaded")
    unfolded, renames = unfold_workspaces(bases)
    if unfolded:
        rehome_workspaces(bases)   # handed-back ids belong to another monitor now
    # No settle wait: the id changes landed before the rehome above.
    apply_renames(renames, settle=0)
    trace("unfolded")
    tidy_placeholders(bases)

    landed = folded.get(was_on, was_on)        # follow focus through both passes
    restore_focus(unfolded.get(landed, landed))

    # Only when ids actually changed hands, so a plain move does not
    # reload the bar for nothing.
    if folded or unfolded or old_bases != bases:
        resync_waybar()
    trace("done")
    # Detached, so the pane cannot take it down with the run itself.
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "watch", "10"],
                     start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def read_or_none(path):
    try:
        with open(path) as fh:
            return fh.read()
    except OSError:
        return None


# ------------------------------------------------------------------ commands

def rederive(layout, geom, root):
    """Replace the placements of every planned monitor with ones derived from
    `geom`. Entries for absent or mirrored monitors are kept, so they come back
    where they were."""
    places = {n: p for n, p in layout["place"].items() if n not in geom}
    places.update(derive_places(geom, root))
    places.pop(root, None)
    layout["place"] = places


def cmd_set(name, slot):
    if slot not in SLOTS:
        die(f"unknown slot {slot!r}; expected one of {', '.join(SLOTS)}")
    live = live_monitors()
    layout = load_layout(live)
    if name not in layout["monitors"]:
        die(f"unknown output {name!r}")
    geom, main, _bases = compute(layout, live)

    if slot == "main":
        if not usable(live, name):
            die(f"{name} is not connected")
        # Promoting a monitor moves nothing: re-root the same geometry on it.
        layout["mirrors"] = [n for n in layout["mirrors"] if n != name]
        if name not in geom:
            geom, main, _bases = compute(layout, live)
        layout["main"] = name
        rederive(layout, geom, name)
    elif slot == "mirror":
        if name == layout["main"]:
            die("the main monitor cannot mirror itself")
        # Its own placement is kept, so un-mirroring puts it back where it was;
        # anything attached to it re-attaches to its anchor in the meantime.
        if name not in layout["mirrors"]:
            layout["mirrors"].append(name)
    elif slot == "extend":
        layout["mirrors"] = [n for n in layout["mirrors"] if n != name]
    else:                                   # left / right of main, top-aligned
        if name == layout["main"]:
            die("the main monitor cannot sit beside itself")
        layout["mirrors"] = [n for n in layout["mirrors"] if n != name]
        layout["place"][name] = {"of": layout["main"], "side": slot, "align": "start"}

    layout = normalise(layout, live)
    save_layout(layout)
    apply(layout, live)
    print(json.dumps(state(layout, live), indent=2))


def cmd_move(name, x, y):
    live = live_monitors()
    layout = load_layout(live)
    geom, main, _bases = compute(layout, live)
    if name not in geom:
        die(f"{name} has no position to move (mirrored or not connected)")
    try:
        x, y = int(round(float(x))), int(round(float(y)))
    except ValueError:
        die("x and y must be numbers")
    w, h = geom[name][2], geom[name][3]
    trace(f"move {name} to {x},{y}")      # every request, even one that snaps back

    if name == main:
        # Everything hangs off main, so "moving main" means moving it relative
        # to the rest: hold the others still and re-root the tree on it.
        others = {n: r for n, r in geom.items() if n != name}
        rect, _anchor = snap_drop(x, y, w, h, others) if others else (None, None)
        if rect is not None:
            moved = dict(others)
            moved[name] = rect
            rederive(layout, moved, main)
    else:
        # Whatever is attached to the dragged monitor travels with it, so it is
        # neither a snap target nor an obstacle; only its own placement changes.
        carried = descendants(layout["place"], name)
        targets = {n: r for n, r in geom.items() if n != name and n not in carried}
        rect, anchor = snap_drop(x, y, w, h, targets) if targets else (None, None)
        if rect is not None:
            rel = relation(targets[anchor], rect) or loose_relation(targets[anchor], rect)
            rel["of"] = anchor
            layout["place"][name] = rel

    if rect is not None:
        layout = normalise(layout, live)
        save_layout(layout)
        apply(layout, live)
    print(json.dumps(state(layout, live), indent=2))


def cmd_apply():
    live = live_monitors()
    layout = load_layout(live)
    save_layout(layout)
    apply(layout, live)


def state(layout, live):
    geom, main, bases = compute(layout, live)
    merged = load_merged()

    def row(name):
        m = live.get(name, {})
        entry = layout["monitors"].get(name, default_entry())
        base = bases.get(name)
        connected = usable(live, name)
        if name == main:
            slot = "main"
        elif name in layout["mirrors"]:
            slot = "mirror"
        elif name in geom:
            slot = "extend" if connected else "standby"
        else:
            slot = "offline"
        x, y, w, h = geom.get(name, (0, 0) + tuple(entry.get("size") or (0, 0)))
        return {
            "name": name,
            "label": m.get("model") or m.get("description") or entry.get("label") or name,
            "make": m.get("make", ""),
            "slot": slot,
            "connected": connected,
            "standby": bool(entry.get("standby")),
            "x": x, "y": y, "width": w, "height": h,
            "refresh": round(m.get("refresh", 0)),
            "mode": entry.get("mode", ""),
            "workspaces": f"{base + 1}-{base + 10}" if base is not None else "",
            "merged": len(merged.get(name, [])) if slot == "mirror" else 0,
        }

    rank = {"main": 0, "extend": 1, "standby": 2, "mirror": 3, "offline": 4}
    rows = sorted((row(n) for n in layout["monitors"]),
                  key=lambda r: (rank[r["slot"]], bases.get(r["name"], 999), r["name"]))
    return {"main": main, "monitors": rows}


def cmd_focused():
    """Print "<monitor> <base>" for the focused output, for ws-switch, ws-move
    and ws-cycle. Deliberately lean -- one hyprctl call and a file read, no
    layout normalising -- because this runs on every Mod+N press."""
    name = ""
    for m in hypr_json("monitors"):
        if m.get("focused"):
            name = (m.get("name") or "").strip()
            break
    try:
        with open(WS_MAP) as fh:
            base = int(json.load(fh).get(name, 0))
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        # Only reached if the generated map is gone; matches the fallback
        # workspace rules hyprland.lua falls back to in the same situation.
        base = {"DP-1": 0, "HDMI-A-1": 10}.get(name, 0)
    print(f"{name} {base}")


def cmd_state():
    live = live_monitors()
    print(json.dumps(state(load_layout(live), live), indent=2))


def with_lock(fn):
    """Two overlapping runs would interleave their dispatches and race each
    other's focus restore, which is how a click landing while the previous one
    is still settling produces a workspace that should not exist. Second run
    waits rather than overlapping."""
    os.makedirs(CFG, exist_ok=True)
    with open(LOCK, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            return fn()
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if args[0] == "state":
        cmd_state()
    elif args[0] == "focused":
        cmd_focused()
    elif args[0] == "watch":
        cmd_watch(args[1] if len(args) > 1 else 5)
    elif args[0] == "apply":
        with_lock(cmd_apply)
    elif args[0] == "set":
        if len(args) != 3:
            die("usage: hypr-display set <output> <main|mirror|extend|left|right>")
        with_lock(lambda: cmd_set(args[1], args[2]))
    elif args[0] == "move":
        if len(args) != 4:
            die("usage: hypr-display move <output> <x> <y>")
        with_lock(lambda: cmd_move(args[1], args[2], args[3]))
    else:
        die(f"unknown command {args[0]!r}")


if __name__ == "__main__":
    main()
