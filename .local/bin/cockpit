#!/usr/bin/env bash
# cockpit - orchestrator-driven tmux cockpit over a persistent opencode server.
#
#   cockpit                                  launch Claude orchestrator
#   cockpit oc [model]                       launch opencode orchestrator
#   cockpit spawn [flags] <name> "<task>" [model] [dir]
#   cockpit say <name> "<task>" [dir]         queue follow-up in the same tab
#   cockpit ls | status                      show registered workers
#   cockpit stop|restart <name>              control a worker tab
#   cockpit forget <name> [--force] [--worktree]
#   cockpit fork <name> [new-name] [task]    fork an overgrown session
#   cockpit gc                               clean stale runtime state
#   cockpit attach                           attach; fails if cockpit is absent
#   cockpit down                             stop tmux, leave owned server running
#   cockpit off                              stop tmux and the owned server
#
# Spawn flags: --replace retires an existing alias; --read-only/--shared opts
# out of the default per-worker git worktree. Configuration remains available
# through COCKPIT_PORT/SESSION/MODEL/VARIANT/ORCH_CMD and COCKPIT_MAX.
set -euo pipefail

PORT="${COCKPIT_PORT:-4096}"
SERVER="http://127.0.0.1:${PORT}"
SESS="${COCKPIT_SESSION:-cockpit}"
DEFAULT_MODEL="${COCKPIT_MODEL:-openai/gpt-5.6-luna}"
VARIANT="${COCKPIT_VARIANT:-max}"
ORCH_CMD="${COCKPIT_ORCH_CMD:-claude --dangerously-skip-permissions}"
MAX_WORKERS="${COCKPIT_MAX:-6}"
OPENCODE="$(command -v opencode 2>/dev/null || printf '%s' /usr/bin/opencode)"
SELF="$(readlink -f "$0")"
RUNTIME_BASE="${XDG_RUNTIME_DIR:-/tmp}/cockpit"
ROOT="${RUNTIME_BASE}/${PORT}"
WORKERS="${ROOT}/workers"
WORKTREES="${ROOT}/worktrees"
LOCKS="${ROOT}/locks"
SERVER_PID_FILE="${ROOT}/server.pid"
SERVER_LOG="${ROOT}/opencode-server.log"
SERVER_LOCK="${ROOT}/server.lock"
REGISTRY_LOCK="${ROOT}/registry.lock"

umask 077

die() {
  printf 'cockpit: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'cockpit: warning: %s\n' "$*" >&2
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing '$1'. Install it first."
}

init_runtime() {
  local path owner
  for path in "$RUNTIME_BASE" "$ROOT" "$WORKERS" "$WORKTREES" "$LOCKS"; do
    if [[ -L "$path" ]]; then
      die "refusing symlinked runtime path '$path'"
    fi
    if [[ ! -e "$path" ]]; then
      mkdir "$path"
    fi
    [[ -d "$path" ]] || die "runtime path is not a directory: '$path'"
    owner="$(stat -c '%u' "$path")"
    [[ "$owner" == "$(id -u)" ]] || die "runtime path is owned by uid $owner: '$path'"
    chmod 700 "$path"
  done
  : >"${ROOT}/.initialized"
}

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid worker name '$1'; use only A-Z, a-z, 0-9, dot, underscore, and hyphen"
  if [[ "$1" == "." || "$1" == ".." ]]; then
    die "invalid worker name '$1'; '.' and '..' are reserved (path traversal)"
  fi
}

validate_port_and_max() {
  [[ "$PORT" =~ ^[0-9]+$ ]] && (( PORT >= 1 && PORT <= 65535 )) || die "COCKPIT_PORT must be an integer from 1 to 65535"
  [[ "$MAX_WORKERS" =~ ^[0-9]+$ ]] && (( MAX_WORKERS >= 1 )) || die "COCKPIT_MAX must be a positive integer"
}

worker_path() {
  printf '%s/%s' "$WORKERS" "$1"
}

field_path() {
  printf '%s/%s' "$(worker_path "$1")" "$2"
}

has_worker() {
  [[ -d "$(worker_path "$1")" ]]
}

read_field() {
  local file
  file="$(field_path "$1" "$2")"
  [[ -f "$file" ]] && IFS= read -r REPLY <"$file" || REPLY=""
  printf '%s' "$REPLY"
}

write_field() {
  local name="$1" field="$2" value="$3" file tmp
  file="$(field_path "$name" "$field")"
  tmp="${file}.tmp.$$"
  printf '%s\n' "$value" >"$tmp"
  mv -f "$tmp" "$file"
}

set_status() {
  write_field "$1" status "$2"
  [[ $# -lt 3 ]] || write_field "$1" last_exit "$3"
}

new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen
  else
    IFS= read -r REPLY </proc/sys/kernel/random/uuid
    printf '%s\n' "$REPLY"
  fi
}

canonical_dir() {
  [[ -d "$1" ]] || die "directory does not exist: '$1'"
  readlink -f "$1"
}

tmux_exec_command() {
  local command="exec" arg quoted
  for arg in "$@"; do
    printf -v quoted '%q' "$arg"
    command+=" ${quoted}"
  done
  printf '%s' "$command"
}

pane_is_live() {
  local pane="$1" found
  [[ -n "$pane" ]] && command -v tmux >/dev/null 2>&1 || return 1
  # display-message exits 0 for a stale pane id, so compare the resolved id.
  found="$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null || printf '')"
  [[ "$found" == "$pane" ]]
}

controller_is_live() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

active_worker_count() {
  local record name pane pid count=0
  shopt -s nullglob
  for record in "$WORKERS"/*; do
    [[ -d "$record" ]] || continue
    name="${record##*/}"
    pane="$(read_field "$name" pane_id)"
    pid="$(read_field "$name" controller_pid)"
    if pane_is_live "$pane" && controller_is_live "$pid"; then
      (( count += 1 ))
    fi
  done
  shopt -u nullglob
  printf '%s\n' "$count"
}

port_is_open() {
  if { exec 7<>"/dev/tcp/127.0.0.1/${PORT}"; } 2>/dev/null; then
    exec 7>&-
    exec 7<&-
    return 0
  fi
  return 1
}

server_pid_valid() {
  local pid="$1" exe expected arg
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ -r "/proc/${pid}/cmdline" && -e "/proc/${pid}/exe" ]] || return 1
  exe="$(readlink -f "/proc/${pid}/exe")"
  expected="$(readlink -f "$OPENCODE")"
  [[ "$exe" == "$expected" ]] || return 1

  mapfile -d '' -t SERVER_ARGS <"/proc/${pid}/cmdline"
  [[ "${SERVER_ARGS[0]:-}" == "$expected" || "${SERVER_ARGS[0]:-}" == "$OPENCODE" ]] || return 1
  [[ "${SERVER_ARGS[1]:-}" == "serve" ]] || return 1
  local saw_port=0 saw_host=0
  for (( arg=2; arg<${#SERVER_ARGS[@]}; arg++ )); do
    if [[ "${SERVER_ARGS[$arg]}" == "--port" && "${SERVER_ARGS[$((arg + 1))]:-}" == "$PORT" ]]; then
      saw_port=1
    fi
    if [[ "${SERVER_ARGS[$arg]}" == "--hostname" && "${SERVER_ARGS[$((arg + 1))]:-}" == "127.0.0.1" ]]; then
      saw_host=1
    fi
  done
  (( saw_port == 1 && saw_host == 1 ))
}

server_is_healthy() {
  curl -fsS --max-time 2 "${SERVER}/api/health" >/dev/null 2>&1
}

# The agent loop lives in the server, not in the worker's client process, so
# killing the pane leaves it running. Abort the session before tearing down.
abort_session() {
  local name="$1" quiet="${2:-0}" sid code response body
  sid="$(read_field "$name" session_id)"
  [[ -n "$sid" ]] || return 0
  if ! server_is_healthy; then
    (( quiet == 1 )) || warn "server on :${PORT} is unreachable; session '$sid' was not aborted"
    return 1
  fi
  # The /api session surface only offers interrupt, which does not stop a
  # running agent. Abort lives on the un-prefixed /session surface.
  response="$(curl -sS -w $'\n%{http_code}' -X POST --max-time 5 \
    "${SERVER}/session/${sid}/abort" 2>/dev/null || printf '\n000')"
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  if [[ "$code" != 200 || "$body" != true ]]; then
    (( quiet == 1 )) || warn "abort for session '$sid' returned HTTP ${code}; it may still be running"
    return 1
  fi
}

session_updated_at() {
  local sid="$1"
  curl -fsS --max-time 3 "${SERVER}/api/session/${sid}" 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try:
    print(json.load(sys.stdin)["data"]["time"]["updated"])
except Exception:
    pass
' 2>/dev/null || printf ''
}

# An abort can fail, so confirm rather than assume, and say so when the agent
# lives on.
warn_if_still_running() {
  local name="$1" sid before after i
  sid="$(read_field "$name" session_id)"
  [[ -n "$sid" ]] || return 0
  server_is_healthy || return 0
  before="$(session_updated_at "$sid")"
  [[ -n "$before" ]] || return 0
  # Tool calls land seconds apart, so sample until one does rather than once.
  for (( i=0; i<10; i++ )); do
    sleep 1
    after="$(session_updated_at "$sid")"
    if [[ -n "$after" && "$after" != "$before" ]]; then
      warn "worker '$name' is still running server-side (session $sid); the tab is gone but the agent keeps working and writing files"
      warn "let it finish, or run 'cockpit off' to kill the server, which stops every worker on :${PORT}"
      return 1
    fi
  done
}

rotate_server_log() {
  local size=0
  if [[ -f "$SERVER_LOG" ]]; then
    size="$(stat -c '%s' "$SERVER_LOG")"
  fi
  if (( size > 1048576 )); then
    mv -f "$SERVER_LOG" "${SERVER_LOG}.1"
  fi
  : >"$SERVER_LOG"
}

ensure_server() {
  local pid="" started_pid i
  init_runtime
  need curl
  need flock
  need /usr/bin/python3
  [[ -x "$OPENCODE" ]] || die "opencode executable not found at '$OPENCODE'"

  exec 8>"$SERVER_LOCK"
  flock 8
  if [[ -s "$SERVER_PID_FILE" ]]; then
    IFS= read -r pid <"$SERVER_PID_FILE"
  fi

  if [[ -n "$pid" ]] && server_pid_valid "$pid"; then
    server_is_healthy || die "owned opencode pid $pid is present but :$PORT is unhealthy; inspect '$SERVER_LOG'"
    flock -u 8
    exec 8>&-
    return 0
  fi

  if server_is_healthy || port_is_open; then
    die "port $PORT is occupied by a server cockpit does not own; choose COCKPIT_PORT or stop it explicitly"
  fi
  [[ -z "$pid" ]] || rm -f "$SERVER_PID_FILE"

  rotate_server_log
  printf 'cockpit: starting owned opencode server on 127.0.0.1:%s ...\n' "$PORT"
  nohup "$OPENCODE" serve --hostname 127.0.0.1 --port "$PORT" >>"$SERVER_LOG" 2>&1 &
  started_pid=$!
  printf '%s\n' "$started_pid" >"${SERVER_PID_FILE}.tmp.$$"
  mv -f "${SERVER_PID_FILE}.tmp.$$" "$SERVER_PID_FILE"

  for (( i=0; i<40; i++ )); do
    if ! kill -0 "$started_pid" 2>/dev/null; then
      rm -f "$SERVER_PID_FILE"
      die "opencode server exited during startup; inspect '$SERVER_LOG'"
    fi
    if server_is_healthy; then
      server_pid_valid "$started_pid" || die "started pid $started_pid failed executable/port ownership verification"
      flock -u 8
      exec 8>&-
      return 0
    fi
    sleep 0.25
  done
  if server_pid_valid "$started_pid"; then
    kill "$started_pid"
  fi
  rm -f "$SERVER_PID_FILE"
  die "opencode server did not become healthy; inspect '$SERVER_LOG'"
}

stop_owned_server() {
  local pid="" i
  init_runtime
  exec 8>"$SERVER_LOCK"
  flock 8
  if [[ -s "$SERVER_PID_FILE" ]]; then
    IFS= read -r pid <"$SERVER_PID_FILE"
  fi
  if [[ -z "$pid" ]]; then
    printf 'cockpit: no cockpit-owned server is recorded on :%s\n' "$PORT"
  elif ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$SERVER_PID_FILE"
    printf 'cockpit: removed stale server pid %s; no owned server is running on :%s\n' "$pid" "$PORT"
  elif ! server_pid_valid "$pid"; then
    die "refusing to kill live but unverified pid '$pid'; inspect it before removing '$SERVER_PID_FILE'"
  else
    kill "$pid"
    for (( i=0; i<40; i++ )); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null && server_pid_valid "$pid"; then
      kill -KILL "$pid"
    fi
    rm -f "$SERVER_PID_FILE"
    printf 'cockpit: stopped owned :%s server (pid %s)\n' "$PORT" "$pid"
  fi
  flock -u 8
  exec 8>&-
}

configure_session() {
  tmux set-option -t "$SESS" remain-on-exit on >/dev/null
  tmux set-option -t "$SESS" mouse on >/dev/null
}

ensure_tmux() {
  local command
  need tmux
  if ! tmux has-session -t "$SESS" 2>/dev/null; then
    command="$(tmux_exec_command bash)"
    tmux new-session -d -s "$SESS" -n orch "$command"
    configure_session
  fi
}

launch() {
  local command
  ensure_server
  need tmux
  if tmux has-session -t "$SESS" 2>/dev/null; then
    printf "cockpit: attaching to existing session '%s'...\n" "$SESS"
  else
    printf -v command 'exec /usr/bin/bash -lc %q' "$ORCH_CMD"
    tmux new-session -d -s "$SESS" -n orch "$command"
    configure_session
    printf 'cockpit: launched orchestrator [%s] and owned brain on :%s\n' "$ORCH_CMD" "$PORT"
  fi
  exec tmux attach -t "$SESS"
}

fetch_sessions() {
  local output="$1"
  curl -fsS --max-time 5 "${SERVER}/api/session" >"$output" || return 1
  /usr/bin/python3 -c '
import json, sys
p=sys.argv[1]
try:
    root=json.load(open(p, encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"invalid JSON: {exc}")
if isinstance(root, list):
    rows=root
elif isinstance(root, dict) and isinstance(root.get("data"), list):
    rows=root["data"]
else:
    raise SystemExit("expected a list or an object with a data list")
for i, row in enumerate(rows):
    if not isinstance(row, dict):
        raise SystemExit(f"session[{i}] is not an object")
    if not isinstance(row.get("id"), str) or not row["id"]:
        raise SystemExit(f"session[{i}].id is not a non-empty string")
    if not isinstance(row.get("title"), str):
        raise SystemExit(f"session[{i}].title is not a string")
    time=row.get("time")
    if not isinstance(time, dict) or not isinstance(time.get("created"), (int, float)):
        raise SystemExit(f"session[{i}].time.created is not numeric")
' "$output" || {
    printf 'cockpit: unexpected /api/session schema; opencode may have changed its API\n' >&2
    return 1
  }
}

snapshot_session_ids() {
  local json_file="$1" ids_file="$2"
  fetch_sessions "$json_file" || return 1
  /usr/bin/python3 -c '
import json, sys
r=json.load(open(sys.argv[1], encoding="utf-8"))
rows=r if isinstance(r, list) else r["data"]
for row in rows:
    print(row["id"])
' "$json_file" >"$ids_file"
}

find_new_session() {
  local json_file="$1" ids_file="$2" title="$3"
  /usr/bin/python3 -c '
import json, sys
r=json.load(open(sys.argv[1], encoding="utf-8"))
rows=r if isinstance(r, list) else r["data"]
before=set(line.rstrip("\n") for line in open(sys.argv[2], encoding="utf-8"))
matches=[row["id"] for row in rows if row["id"] not in before and row["title"] == sys.argv[3]]
if len(matches) == 1:
    print(matches[0])
elif len(matches) > 1:
    raise SystemExit(3)
else:
    raise SystemExit(2)
' "$json_file" "$ids_file" "$title"
}

capture_new_session() {
  local before="$1" title="$2" run_pid="$3" json_file result rc i
  json_file="${before}.poll"
  for (( i=0; i<200; i++ )); do
    fetch_sessions "$json_file" || return 125
    if result="$(find_new_session "$json_file" "$before" "$title")"; then
      rm -f "$json_file"
      printf '%s' "$result"
      return 0
    else
      rc=$?
      if (( rc == 3 )); then
        printf "cockpit: multiple new sessions matched unique title '%s'; refusing ambiguous identity\n" "$title" >&2
        rm -f "$json_file"
        return 125
      fi
      (( rc == 2 )) || {
        rm -f "$json_file"
        return 125
      }
    fi
    if ! kill -0 "$run_pid" 2>/dev/null && (( i >= 20 )); then
      break
    fi
    sleep 0.1
  done
  rm -f "$json_file"
  printf "cockpit: no unique new opencode session appeared for title '%s'\n" "$title" >&2
  return 125
}

variant_args() {
  VARIANT_ARGS=()
  if [[ -n "$VARIANT" ]]; then
    VARIANT_ARGS=(--variant "$VARIANT")
  fi
}

tree_lock_for() {
  /usr/bin/python3 -c 'import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())' "$1"
}

prepare_work_dir() {
  local name="$1" requested="$2" instance="$3" shared="$4"
  local source_dir source_root rel worktree branch lock_key
  source_dir="$(canonical_dir "$requested")"
  PREP_SOURCE_DIR="$source_dir"
  PREP_SOURCE_ROOT=""
  PREP_WORK_DIR="$source_dir"
  PREP_WORKTREE=""
  PREP_BRANCH=""
  PREP_MODE="shared"

  lock_key="$(tree_lock_for "$source_dir")"
  PREP_TREE_LOCK="${LOCKS}/tree-${lock_key}.lock"
  if (( shared == 1 )); then
    PREP_MODE="shared"
    if source_root="$(git -C "$source_dir" rev-parse --show-toplevel 2>/dev/null)"; then
      source_root="$(readlink -f "$source_root")"
      lock_key="$(tree_lock_for "$source_root")"
      PREP_SOURCE_ROOT="$source_root"
      PREP_TREE_LOCK="${LOCKS}/tree-${lock_key}.lock"
    fi
    return 0
  fi

  if ! source_root="$(git -C "$source_dir" rev-parse --show-toplevel 2>/dev/null)"; then
    warn "'$source_dir' is not in a git worktree; using the shared directory with serialized execution"
    return 0
  fi
  source_root="$(readlink -f "$source_root")"
  rel="${source_dir#"$source_root"}"
  worktree="${WORKTREES}/${name}-${instance:0:8}"
  branch="cockpit/${name}-${instance:0:8}"
  if ! git -C "$source_root" worktree add -b "$branch" "$worktree" HEAD; then
    warn "could not create git worktree; using '$source_dir' with serialized execution"
    return 0
  fi
  PREP_SOURCE_ROOT="$source_root"
  PREP_WORKTREE="$worktree"
  PREP_BRANCH="$branch"
  PREP_WORK_DIR="${worktree}${rel}"
  PREP_MODE="worktree"
  lock_key="$(tree_lock_for "$worktree")"
  PREP_TREE_LOCK="${LOCKS}/tree-${lock_key}.lock"
}

init_worker_record() {
  local name="$1" instance="$2" model="$3" title="$4" parent_session="$5"
  local record fifo
  record="$(worker_path "$name")"
  mkdir "$record" "$record/queue"
  fifo="$record/tasks.fifo"
  mkfifo "$fifo"
  write_field "$name" name "$name"
  write_field "$name" instance_uuid "$instance"
  write_field "$name" session_id ""
  write_field "$name" parent_session "$parent_session"
  write_field "$name" pane_id ""
  write_field "$name" controller_pid ""
  write_field "$name" work_dir "$PREP_WORK_DIR"
  write_field "$name" source_dir "$PREP_SOURCE_DIR"
  write_field "$name" source_root "$PREP_SOURCE_ROOT"
  write_field "$name" worktree "$PREP_WORKTREE"
  write_field "$name" branch "$PREP_BRANCH"
  write_field "$name" mode "$PREP_MODE"
  write_field "$name" tree_lock "$PREP_TREE_LOCK"
  write_field "$name" model "$model"
  write_field "$name" title "$title"
  write_field "$name" status starting
  write_field "$name" last_exit ""
  write_field "$name" created_at "$(date +%s)"
  write_field "$name" sequence 0
  write_field "$name" fifo "$fifo"
}

map_task_dir() {
  local name="$1" requested="$2" worktree source_root source_dir work_dir canonical rel
  worktree="$(read_field "$name" worktree)"
  source_root="$(read_field "$name" source_root)"
  source_dir="$(read_field "$name" source_dir)"
  work_dir="$(read_field "$name" work_dir)"
  if [[ -z "$requested" ]]; then
    printf '%s' "$work_dir"
    return 0
  fi
  canonical="$(canonical_dir "$requested")"
  if [[ -n "$worktree" ]]; then
    if [[ "$canonical" == "$source_root" || "$canonical" == "$source_root"/* ]]; then
      rel="${canonical#"$source_root"}"
      [[ -d "${worktree}${rel}" ]] || die "mapped worktree directory does not exist: '${worktree}${rel}'"
      printf '%s' "${worktree}${rel}"
    elif [[ "$canonical" == "$worktree" || "$canonical" == "$worktree"/* ]]; then
      printf '%s' "$canonical"
    else
      die "worker '$name' is isolated in '$worktree'; follow-up dir must be inside its source/worktree"
    fi
  else
    printf '%s' "$canonical"
  fi
}

enqueue_task() {
  local name="$1" task="$2" requested_dir="${3:-}" record queue sequence temp item fifo task_dir
  record="$(worker_path "$name")"
  [[ -d "$record" ]] || die "no registered worker named '$name'"
  queue="$record/queue"
  exec 9>"$record/queue.lock"
  flock 9
  sequence="$(read_field "$name" sequence)"
  [[ "$sequence" =~ ^[0-9]+$ ]] || sequence=0
  (( sequence += 1 ))
  write_field "$name" sequence "$sequence"
  task_dir="$(map_task_dir "$name" "$requested_dir")"
  printf -v item '%020d' "$sequence"
  temp="$queue/.tmp-${item}-$$"
  mkdir "$temp"
  printf '%s' "$task" >"$temp/task"
  printf '%s\n' "$task_dir" >"$temp/dir"
  mv "$temp" "$queue/$item"
  fifo="$(read_field "$name" fifo)"
  if [[ -p "$fifo" ]]; then
    exec 7<>"$fifo"
    printf 'wake\n' >&7
    exec 7>&-
    exec 7<&-
  fi
  flock -u 9
  exec 9>&-
}

start_controller_pane() {
  local name="$1" command pane pid i
  ensure_tmux
  command="$(tmux_exec_command "$SELF" __run "$name")"
  pane="$(tmux new-window -d -P -F '#{pane_id}' -t "$SESS" -n "$name" "$command")"
  write_field "$name" pane_id "$pane"
  tmux set-option -w -t "$pane" remain-on-exit on >/dev/null
  tmux set-option -w -t "$pane" automatic-rename off >/dev/null
  for (( i=0; i<100; i++ )); do
    pid="$(read_field "$name" controller_pid)"
    if controller_is_live "$pid" && pane_is_live "$pane"; then
      printf '%s' "$pane"
      return 0
    fi
    sleep 0.02
  done
  set_status "$name" failed 125
  die "controller for '$name' did not become ready in pane $pane"
}

stop_worker_internal() {
  local name="$1" quiet="${2:-0}" pane pid i abort_confirmed=0
  has_worker "$name" || die "no registered worker named '$name'"
  # The controller holds session.lock for as long as its task runs, so the
  # abort has to go out before we queue up behind it, not after.
  if abort_session "$name" "$quiet"; then
    abort_confirmed=1
  fi
  exec 5>"$(field_path "$name" session.lock)"
  # A busy controller holds this for the whole task, so never block on it:
  # stopping a working worker is exactly when the lock is unavailable.
  if ! flock -w 15 5; then
    (( quiet == 1 )) || warn "worker '$name' session lock was not acquired; tearing it down anyway"
  fi
  pane="$(read_field "$name" pane_id)"
  pid="$(read_field "$name" controller_pid)"
  set_status "$name" stopped "$(read_field "$name" last_exit)"
  if pane_is_live "$pane"; then
    tmux kill-pane -t "$pane"
  elif controller_is_live "$pid"; then
    kill "$pid"
  fi
  if controller_is_live "$pid"; then
    for (( i=0; i<50; i++ )); do
      controller_is_live "$pid" || break
      sleep 0.02
    done
  fi
  write_field "$name" pane_id ""
  write_field "$name" controller_pid ""
  flock -u 5 2>/dev/null || true
  exec 5>&-
  (( quiet == 1 )) || printf "cockpit: stopped worker '%s'\n" "$name"
  if (( abort_confirmed == 0 && quiet == 0 )); then
    warn_if_still_running "$name" || true
  fi
}

remove_worktree() {
  local name="$1" worktree source_root branch
  worktree="$(read_field "$name" worktree)"
  source_root="$(read_field "$name" source_root)"
  branch="$(read_field "$name" branch)"
  [[ -n "$worktree" ]] || return 0
  if [[ -n "$source_root" && -d "$source_root" ]]; then
    if git -C "$source_root" worktree remove --force "$worktree"; then
      if [[ -n "$branch" ]] && ! git -C "$source_root" branch -D "$branch" >/dev/null; then
        warn "removed worktree but could not delete branch '$branch'"
      fi
    else
      warn "could not remove worktree '$worktree'"
      return 1
    fi
  elif [[ -d "$worktree" ]]; then
    warn "source repository is unavailable; leaving worktree '$worktree'"
    return 1
  fi
}

retire_worker() {
  local name="$1"
  has_worker "$name" || return 0
  stop_worker_internal "$name" 1
  remove_worktree "$name"
  rm -rf "$(worker_path "$name")"
}

spawn_worker() {
  local name="$1" task="$2" model="$3" requested_dir="$4" replace="$5" shared="$6" parent_session="${7:-}"
  local instance title command pane count
  validate_name "$name"
  ensure_server
  ensure_tmux
  init_runtime
  exec 6>"$REGISTRY_LOCK"
  flock 6
  if has_worker "$name"; then
    if (( replace == 0 )); then
      die "worker '$name' already exists; use restart/forget or pass --replace"
    fi
    retire_worker "$name"
  fi
  count="$(active_worker_count)"
  (( count < MAX_WORKERS )) || die "active-worker limit reached ($count/$MAX_WORKERS); stop a worker or raise COCKPIT_MAX"

  instance="$(new_uuid)"
  title="worker-${name}-${instance}"
  prepare_work_dir "$name" "$requested_dir" "$instance" "$shared"
  init_worker_record "$name" "$instance" "$model" "$title" "$parent_session"
  enqueue_task "$name" "$task" ""
  pane="$(start_controller_pane "$name")"
  flock -u 6
  exec 6>&-
  printf "cockpit: spawned worker '%s' (%s, %s) in pane %s\n" "$name" "$model" "$PREP_MODE" "$pane"
}

run_new_session() {
  local name="$1" task="$2" dir="$3" model="$4" title="$5" parent="$6"
  local record before_json before_ids run_pid sid="" capture_rc=0 run_rc=0
  record="$(worker_path "$name")"
  before_json="$record/sessions-before.json"
  before_ids="$record/sessions-before.ids"
  snapshot_session_ids "$before_json" "$before_ids" || return 125
  variant_args

  NEW_ARGS=(run "DELEGATED-WORKER: $task" --attach "$SERVER" --title "$title" --dangerously-skip-permissions --dir "$dir")
  if [[ -n "$parent" ]]; then
    NEW_ARGS+=(-s "$parent" --fork)
  else
    NEW_ARGS+=(-m "$model")
  fi
  NEW_ARGS+=("${VARIANT_ARGS[@]}")
  "$OPENCODE" "${NEW_ARGS[@]}" &
  run_pid=$!
  if sid="$(capture_new_session "$before_ids" "$title" "$run_pid")"; then
    write_field "$name" session_id "$sid"
  else
    capture_rc=$?
    if kill -0 "$run_pid" 2>/dev/null; then
      kill "$run_pid"
    fi
  fi
  if wait "$run_pid"; then
    run_rc=0
  else
    run_rc=$?
  fi
  rm -f "$before_json" "$before_ids"
  if (( capture_rc != 0 )); then
    (( run_rc != 0 )) && return "$run_rc"
    return "$capture_rc"
  fi
  return "$run_rc"
}

run_existing_session() {
  local task="$1" dir="$2" sid="$3"
  variant_args
  CONTINUE_ARGS=(run "DELEGATED-WORKER: $task" --attach "$SERVER" -s "$sid" --dangerously-skip-permissions --dir "$dir")
  CONTINUE_ARGS+=("${VARIANT_ARGS[@]}")
  "$OPENCODE" "${CONTINUE_ARGS[@]}"
}

run_queue_item() {
  local name="$1" item="$2" task dir sid model title parent tree_lock rc=0
  IFS= read -r dir <"$item/dir"
  task="$(<"$item/task")"
  sid="$(read_field "$name" session_id)"
  model="$(read_field "$name" model)"
  title="$(read_field "$name" title)"
  parent="$(read_field "$name" parent_session)"
  tree_lock="$(read_field "$name" tree_lock)"
  [[ -d "$dir" ]] || {
    printf "cockpit: task directory disappeared: '%s'\n" "$dir" >&2
    return 125
  }

  set_status "$name" running ""
  printf '\n\033[1;36m> worker %s\033[0m  (%s)\n\n' "$name" "${sid:-new session}"
  exec 5>"$(field_path "$name" session.lock)"
  flock 5
  exec 4>"$tree_lock"
  flock 4
  if [[ -z "$sid" ]]; then
    if run_new_session "$name" "$task" "$dir" "$model" "$title" "$parent"; then
      rc=0
    else
      rc=$?
    fi
  else
    if run_existing_session "$task" "$dir" "$sid"; then
      rc=0
    else
      rc=$?
    fi
  fi
  flock -u 4
  exec 4>&-
  flock -u 5
  exec 5>&-
  return "$rc"
}

controller_exit() {
  local name="$1" status
  status="$(read_field "$name" status)"
  if [[ "$status" != failed && "$status" != stopped ]]; then
    set_status "$name" stopped "$(read_field "$name" last_exit)"
  fi
  write_field "$name" controller_pid ""
}

controller() {
  local name="$1" record fifo item rc status
  validate_name "$name"
  record="$(worker_path "$name")"
  [[ -d "$record" ]] || die "worker registry disappeared for '$name'"
  exec 10>"$record/controller.lock"
  flock -n 10 || die "another controller already owns worker '$name'"
  fifo="$(read_field "$name" fifo)"
  [[ -p "$fifo" ]] || die "worker FIFO is missing for '$name'"
  write_field "$name" controller_pid "$$"
  write_field "$name" pane_id "${TMUX_PANE:-$(read_field "$name" pane_id)}"
  trap 'exit 143' HUP INT TERM
  trap 'controller_exit "$name"' EXIT
  exec 3<>"$fifo"
  printf '\033[1;36mworker %s controller ready\033[0m\n' "$name"

  while :; do
    item=""
    shopt -s nullglob
    for item in "$record/queue"/[0-9]*; do
      [[ -d "$item" ]] && break
      item=""
    done
    shopt -u nullglob
    if [[ -n "$item" ]]; then
      if run_queue_item "$name" "$item"; then
        rc=0
      else
        rc=$?
      fi
      rm -rf "$item"
      if (( rc == 0 )); then
        set_status "$name" idle 0
        printf '\n\033[2m-- worker "%s" idle; session warm, follow-ups stay in this pane --\033[0m\n' "$name"
      else
        set_status "$name" failed "$rc"
        printf '\n\033[1;31m-- worker "%s" FAILED (exit %s); controller remains available for a queued retry --\033[0m\n' "$name" "$rc"
      fi
      continue
    fi
    status="$(read_field "$name" status)"
    [[ "$status" == starting ]] && set_status "$name" idle "$(read_field "$name" last_exit)"
    if ! IFS= read -r -u 3 _; then
      sleep 0.1
    fi
  done
}

refresh_dead_worker() {
  local name="$1" status pane pid
  status="$(read_field "$name" status)"
  pane="$(read_field "$name" pane_id)"
  pid="$(read_field "$name" controller_pid)"
  if [[ "$status" != stopped && "$status" != failed ]] && { ! pane_is_live "$pane" || ! controller_is_live "$pid"; }; then
    set_status "$name" stopped "$(read_field "$name" last_exit)"
    write_field "$name" pane_id ""
    write_field "$name" controller_pid ""
  fi
}

session_metrics() {
  local json_file="$1" sid="$2"
  /usr/bin/python3 -c '
import json, sys, time
r=json.load(open(sys.argv[1], encoding="utf-8"))
rows=r if isinstance(r, list) else r["data"]
row=next((x for x in rows if x["id"] == sys.argv[2]), None)
if row is None:
    print("- -")
else:
    age=max(0, int(time.time() - row["time"]["created"] / 1000))
    tokens=row.get("tokens") or {}
    context=tokens.get("input", "-")
    print(f"{age} {context}")
' "$json_file" "$sid"
}

format_age() {
  local seconds="$1"
  [[ "$seconds" =~ ^[0-9]+$ ]] || { printf '-'; return; }
  if (( seconds < 60 )); then printf '%ss' "$seconds"
  elif (( seconds < 3600 )); then printf '%sm' "$((seconds / 60))"
  elif (( seconds < 86400 )); then printf '%sh' "$((seconds / 3600))"
  else printf '%sd' "$((seconds / 86400))"
  fi
}

show_status() {
  local sessions record name status model sid short dir exit_code created age context metrics now overgrown=()
  ensure_server
  init_runtime
  sessions="$(mktemp "${ROOT}/sessions.XXXXXX")"
  fetch_sessions "$sessions" || {
    rm -f "$sessions"
    die "could not read opencode sessions"
  }
  printf '%-16s %-9s %-25s %-13s %-5s %-7s %-10s %s\n' NAME STATUS MODEL SESSION EXIT AGE CONTEXT DIR
  now="$(date +%s)"
  shopt -s nullglob
  for record in "$WORKERS"/*; do
    [[ -d "$record" ]] || continue
    name="${record##*/}"
    refresh_dead_worker "$name"
    status="$(read_field "$name" status)"
    model="$(read_field "$name" model)"
    sid="$(read_field "$name" session_id)"
    short="${sid:0:12}"
    [[ -n "$short" ]] || short="-"
    dir="$(read_field "$name" work_dir)"
    exit_code="$(read_field "$name" last_exit)"
    [[ -n "$exit_code" ]] || exit_code="-"
    created="$(read_field "$name" created_at)"
    age="-"
    context="-"
    if [[ -n "$sid" ]]; then
      metrics="$(session_metrics "$sessions" "$sid")"
      age="${metrics%% *}"
      context="${metrics#* }"
    elif [[ "$created" =~ ^[0-9]+$ ]]; then
      age="$((now - created))"
    fi
    if [[ "$context" =~ ^[0-9]+$ ]] && (( context >= 200000 )); then
      overgrown+=("$name")
    fi
    printf '%-16.16s %-9.9s %-25.25s %-13.13s %-5.5s %-7.7s %-10.10s %s\n' \
      "$name" "$status" "$model" "$short" "$exit_code" "$(format_age "$age")" "$context" "$dir"
  done
  shopt -u nullglob
  rm -f "$sessions"
  if (( ${#overgrown[@]} > 0 )); then
    printf 'cockpit: large context detected for: %s. Consider `cockpit fork <name>`.\n' "${overgrown[*]}"
  fi
}

restart_worker() {
  local name="$1" sid pane
  validate_name "$name"
  has_worker "$name" || die "no registered worker named '$name'"
  exec 6>"$REGISTRY_LOCK"
  flock 6
  sid="$(read_field "$name" session_id)"
  if [[ -z "$sid" ]]; then
    flock -u 6
    exec 6>&-
    die "worker '$name' has no captured session to restart"
  fi
  stop_worker_internal "$name" 1
  set_status "$name" starting "$(read_field "$name" last_exit)"
  pane="$(start_controller_pane "$name")"
  flock -u 6
  exec 6>&-
  printf "cockpit: restarted worker '%s' against session %s in pane %s\n" "$name" "$sid" "$pane"
}

forget_worker() {
  local name="$1" force="$2" with_worktree="$3" answer worktree
  validate_name "$name"
  has_worker "$name" || die "no registered worker named '$name'"
  exec 6>"$REGISTRY_LOCK"
  flock 6
  worktree="$(read_field "$name" worktree)"
  if (( force == 0 )); then
    if [[ ! -t 0 ]]; then
      flock -u 6
      exec 6>&-
      die "confirmation requires a terminal; rerun with --force"
    fi
    printf "Forget worker '%s' registry%s? [y/N] " "$name" "$([[ $with_worktree == 1 ]] && printf ' and worktree' || printf '')"
    IFS= read -r answer
    if [[ "$answer" != y && "$answer" != Y && "$answer" != yes && "$answer" != YES ]]; then
      flock -u 6
      exec 6>&-
      die "cancelled"
    fi
  fi
  stop_worker_internal "$name" 1
  if (( with_worktree == 1 )); then
    remove_worktree "$name"
  elif [[ -n "$worktree" ]]; then
    warn "leaving worktree '$worktree'; cockpit gc can remove it after the record is gone"
  fi
  rm -rf "$(worker_path "$name")"
  flock -u 6
  exec 6>&-
  printf "cockpit: forgot worker '%s'\n" "$name"
}

mark_all_stopped() {
  local record name status
  shopt -s nullglob
  for record in "$WORKERS"/*; do
    [[ -d "$record" ]] || continue
    name="${record##*/}"
    status="$(read_field "$name" status)"
    [[ "$status" == stopped || "$status" == failed ]] || abort_session "$name" 1 || true
    [[ "$status" == failed ]] || set_status "$name" stopped "$(read_field "$name" last_exit)"
    write_field "$name" pane_id ""
    write_field "$name" controller_pid ""
  done
  shopt -u nullglob
}

gc_runtime() {
  local record name item path referenced source
  init_runtime
  need git
  exec 6>"$REGISTRY_LOCK"
  flock 6
  shopt -s nullglob
  for record in "$WORKERS"/*; do
    [[ -d "$record" ]] || { rm -f "$record"; continue; }
    name="${record##*/}"
    if [[ ! -f "$record/name" || "$(read_field "$name" name)" != "$name" ]]; then
      warn "removing malformed registry record '$record'"
      rm -rf "$record"
      continue
    fi
    refresh_dead_worker "$name"
    for item in "$record/queue"/.tmp-*; do
      rm -rf "$item"
    done
  done
  for path in "$WORKTREES"/*; do
    [[ -d "$path" ]] || continue
    referenced=0
    for record in "$WORKERS"/*; do
      [[ -d "$record" ]] || continue
      name="${record##*/}"
      [[ "$(read_field "$name" worktree)" == "$path" ]] && referenced=1
    done
    if (( referenced == 0 )); then
      source="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || printf '')"
      if [[ -n "$source" ]]; then
        if ! git -C "$path" worktree remove --force "$path"; then
          warn "could not unregister orphan worktree '$path'; removing its runtime directory"
          rm -rf "$path"
        fi
      else
        rm -rf "$path"
      fi
    fi
  done
  shopt -u nullglob
  rm -f "$ROOT"/sessions.* "$ROOT"/*.tmp.*
  if [[ -f "$SERVER_LOG" && "$(stat -c '%s' "$SERVER_LOG")" -gt 1048576 ]]; then
    mv -f "$SERVER_LOG" "${SERVER_LOG}.1"
    : >"$SERVER_LOG"
  fi
  flock -u 6
  exec 6>&-
  printf 'cockpit: garbage collection complete\n'
}

show_help() {
  /usr/bin/printf '%s\n' \
    'cockpit                                  launch Claude orchestrator' \
    'cockpit oc [model]                       launch opencode orchestrator' \
    'cockpit spawn [--replace] [--read-only] <name> "<task>" [model] [dir]' \
    'cockpit say <name> "<task>" [dir]         queue in the same worker tab' \
    'cockpit ls | status                      list registered workers' \
    'cockpit stop|restart <name>              stop/restart the controller' \
    'cockpit forget <name> [--force] [--worktree]' \
    'cockpit fork <name> [new-name] [task]    fork an existing session' \
    'cockpit gc                               clean stale runtime state' \
    'cockpit attach | down | off              manage cockpit lifecycle'
}

validate_port_and_max
init_runtime

case "${1:-up}" in
  up|start|"")
    launch
    ;;

  oc|opencode)
    if [[ -n "${2:-}" ]]; then
      printf -v ORCH_CMD '%q -m %q' "$OPENCODE" "$2"
    else
      printf -v ORCH_CMD '%q' "$OPENCODE"
    fi
    launch
    ;;

  attach)
    need tmux
    tmux has-session -t "$SESS" 2>/dev/null || die "no cockpit tmux session '$SESS' exists; run cockpit first"
    exec tmux attach -t "$SESS"
    ;;

  spawn)
    shift
    replace=0
    shared=1                      # default: edit IN-TREE (old behavior)
    while [[ "${1:-}" == --* ]]; do
      case "$1" in
        --replace) replace=1 ;;
        --worktree|--isolate) shared=0 ;;   # opt in to git-worktree isolation
        --read-only|--shared) shared=1 ;;   # explicit in-tree (already default)
        --) shift; break ;;
        *) die "unknown spawn flag '$1'" ;;
      esac
      shift
    done
    name="${1:?usage: cockpit spawn [--replace] [--worktree] <name> \"<task>\" [model] [dir]}"
    task="${2:?usage: cockpit spawn [--replace] [--worktree] <name> \"<task>\" [model] [dir]}"
    model="${3:-$DEFAULT_MODEL}"
    dir="${4:-$PWD}"
    spawn_worker "$name" "$task" "$model" "$dir" "$replace" "$shared"
    ;;

  say)
    name="${2:?usage: cockpit say <name> \"<task>\" [dir]}"
    task="${3:?usage: cockpit say <name> \"<task>\" [dir]}"
    dir="${4:-}"
    validate_name "$name"
    has_worker "$name" || die "no registered worker named '$name' (see: cockpit ls)"
    pid="$(read_field "$name" controller_pid)"
    pane="$(read_field "$name" pane_id)"
    controller_is_live "$pid" && pane_is_live "$pane" || die "worker '$name' is not active; run cockpit restart $name"
    enqueue_task "$name" "$task" "$dir"
    printf "cockpit: queued follow-up for warm worker '%s' in pane %s\n" "$name" "$pane"
    ;;

  ls|status)
    show_status
    ;;

  stop)
    name="${2:?usage: cockpit stop <name>}"
    validate_name "$name"
    exec 6>"$REGISTRY_LOCK"
    flock 6
    stop_worker_internal "$name"
    flock -u 6
    exec 6>&-
    ;;

  restart)
    name="${2:?usage: cockpit restart <name>}"
    restart_worker "$name"
    ;;

  forget)
    name="${2:?usage: cockpit forget <name> [--force] [--worktree]}"
    force=0
    with_worktree=0
    shift 2
    while (( $# > 0 )); do
      case "$1" in
        --force|-f) force=1 ;;
        --worktree) with_worktree=1 ;;
        *) die "unknown forget flag '$1'" ;;
      esac
      shift
    done
    forget_worker "$name" "$force" "$with_worktree"
    ;;

  fork)
    source_name="${2:?usage: cockpit fork <name> [new-name] [task]}"
    validate_name "$source_name"
    has_worker "$source_name" || die "no registered worker named '$source_name'"
    parent="$(read_field "$source_name" session_id)"
    [[ -n "$parent" ]] || die "worker '$source_name' has no captured session to fork"
    name="${3:-${source_name}-fork}"
    task="${4:-Continue from the parent session in a fresh context. Review the current work and report the next action.}"
    model="$(read_field "$source_name" model)"
    dir="$(read_field "$source_name" source_dir)"
    spawn_worker "$name" "$task" "$model" "$dir" 0 1 "$parent"
    ;;

  gc)
    gc_runtime
    ;;

  down)
    need tmux
    if tmux has-session -t "$SESS" 2>/dev/null; then
      tmux kill-session -t "$SESS"
      mark_all_stopped
      printf "cockpit: tmux session '%s' stopped; owned server on :%s left running\n" "$SESS" "$PORT"
    else
      printf "cockpit: no tmux session '%s'\n" "$SESS"
    fi
    ;;

  off|kill)
    if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$SESS" 2>/dev/null; then
      tmux kill-session -t "$SESS"
      mark_all_stopped
      printf "cockpit: tmux session '%s' stopped\n" "$SESS"
    fi
    stop_owned_server
    ;;

  __run)
    name="${2:?internal usage: cockpit __run <name>}"
    controller "$name"
    ;;

  __say)
    sid="${2:?internal usage: cockpit __say <sid> <name> <dir> <task-file>}"
    name="${3:?internal usage: cockpit __say <sid> <name> <dir> <task-file>}"
    dir="${4:?internal usage: cockpit __say <sid> <name> <dir> <task-file>}"
    task_file="${5:?internal usage: cockpit __say <sid> <name> <dir> <task-file>}"
    validate_name "$name"
    has_worker "$name" || die "no registered worker named '$name'"
    [[ "$(read_field "$name" session_id)" == "$sid" ]] || die "session id does not match registry for '$name'"
    task="$(<"$task_file")"
    rm -f "$task_file"
    enqueue_task "$name" "$task" "$dir"
    ;;

  help|-h|--help)
    show_help
    ;;

  *)
    show_help >&2
    exit 1
    ;;
esac
