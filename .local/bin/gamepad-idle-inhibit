#!/usr/bin/env python3
"""Treat GAMEPAD input as activity so the screen doesn't lock mid-match.

hypridle and Hyprland only count wl_seat pointer/keyboard as activity; a
controller in gamepad/XInput mode is a joystick, invisible to the idle path.
During a fullscreen game with a leverless/hitbox pad (e.g. Haute42) no
mouse/keyboard events fire, so hypridle locks at its 5-min timeout while you're
actively playing.

This reads the legacy JOYSTICK node (/dev/input/js*), NOT the evdev event*
node, on purpose: when Steam Input is on it does an exclusive EVIOCGRAB on the
physical controller's evdev device (event*), so a game reads a Steam-provided
virtual pad and the real event* goes silent. The grab is evdev-only; joydev
(js*) still delivers the button/axis events, so reading js* works whether or
not Steam has grabbed the pad.

Holds an org.freedesktop.ScreenSaver inhibit (same mechanism as
video-idle-inhibit, which hypridle honors) while a gamepad has produced input
within the last GRACE seconds; releases after, so setting the pad down / walking
away still lets the screen lock and suspend.

If this process dies the dbus connection closes and the inhibit auto-releases,
so it can never leave the screen stuck awake.
"""
import glob
import os
import select
import struct
import time

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio

JS_SIZE = struct.calcsize("=IhBB")  # js_event: u32 time, s16 value, u8 type, u8 number
JS_BUTTON = 0x01
JS_AXIS = 0x02
JS_INIT = 0x80          # synthetic state-sync events sent on open; not real input
GRACE = 120             # keep awake this long after the last gamepad input
SCAN = 5                # rescan for plugged/unplugged pads this often
AXIS_DEADZONE = 3000    # ignore analog jitter/drift; hats jump ±32767 so still counted
EXCLUDE_VENDORS = {"26ce"}  # ASRock LED phantom joystick (js0)

_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
_ss = Gio.DBusProxy.new_sync(
    _bus, Gio.DBusProxyFlags.NONE, None,
    "org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver",
    "org.freedesktop.ScreenSaver", None,
)


def _read(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return ""


def scan():
    """Return {js_path: human_name} for real (non-ASRock) joystick nodes."""
    found = {}
    for path in sorted(glob.glob("/dev/input/js*")):
        js = os.path.basename(path)
        if _read(f"/sys/class/input/{js}/device/id/vendor").lower() in EXCLUDE_VENDORS:
            continue
        found[path] = _read(f"/sys/class/input/{js}/device/name") or js
    return found


def main():
    open_fds = {}          # path -> fd
    meta = {}              # fd -> human name
    last_axis = {}         # (fd, number) -> value
    last_active = 0.0
    cookie = None
    last_scan = 0.0
    poll = select.poll()

    def resync():
        want = scan()
        for path in list(open_fds):
            if path not in want:
                fd = open_fds.pop(path)
                poll.unregister(fd)
                meta.pop(fd, None)
                try:
                    os.close(fd)
                except OSError:
                    pass
        for path, human in want.items():
            if path in open_fds:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                continue
            open_fds[path] = fd
            meta[fd] = human
            poll.register(fd, select.POLLIN)
            print(f"watching gamepad: {human} ({path})", flush=True)

    while True:
        try:
            now = time.time()
            if now - last_scan >= SCAN:
                resync()
                last_scan = now

            for fd, _ev in poll.poll(1000):
                try:
                    data = os.read(fd, JS_SIZE * 128)
                except OSError:
                    continue
                for off in range(0, len(data) - JS_SIZE + 1, JS_SIZE):
                    _t, value, jtype, number = struct.unpack_from("=IhBB", data, off)
                    if jtype & JS_INIT:
                        continue  # ignore open-time state sync
                    if jtype == JS_BUTTON:
                        last_active = time.time()
                    elif jtype == JS_AXIS:
                        prev = last_axis.get((fd, number))
                        if prev is None or abs(value - prev) >= AXIS_DEADZONE:
                            last_active = time.time()
                        last_axis[(fd, number)] = value

            now = time.time()
            active = (now - last_active) <= GRACE and bool(open_fds)
            if active and cookie is None:
                result = _ss.Inhibit("(ss)", "gamepad-idle-inhibit", "gamepad in use")
                cookie = result[0] if isinstance(result, tuple) else result
                print("gamepad active -> idle inhibited", flush=True)
            elif not active and cookie is not None:
                try:
                    _ss.UnInhibit("(u)", cookie)
                except Exception:
                    pass
                cookie = None
                print("gamepad idle -> inhibit released", flush=True)
        except Exception as e:
            # Never let an exception kill the loop while holding an inhibit
            # (that was the original video-idle-inhibit stuck-awake bug).
            if cookie is not None:
                try:
                    _ss.UnInhibit("(u)", cookie)
                except Exception:
                    pass
                cookie = None
            print(f"loop error (recovered): {e}", flush=True)
            time.sleep(1)


if __name__ == "__main__":
    main()
