#!/usr/bin/env python3
"""Keep the screen awake while VIDEO is playing.

Holds an org.freedesktop.ScreenSaver inhibit (which hypridle honors, since
`ignore_dbus_inhibit = false`) whenever a video-capable player is Playing per
playerctl. Ignores pure-audio players like Spotify, so music does NOT keep the
screen on. Releases the inhibit as soon as nothing video-ish is playing, so
normal dim/lock/suspend resume when you pause or stop.

If this process dies, the dbus connection closes and the inhibit auto-releases,
so it can never leave the screen stuck awake.
"""
import subprocess

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

# Players treated as pure audio -> never inhibit for these.
AUDIO_ONLY = {"spotify", "spotifyd", "mopidy", "cmus", "mpd", "ncspot", "playerctld"}
POLL_SECONDS = 5

_bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
_ss = Gio.DBusProxy.new_sync(
    _bus, Gio.DBusProxyFlags.NONE, None,
    "org.freedesktop.ScreenSaver", "/org/freedesktop/ScreenSaver",
    "org.freedesktop.ScreenSaver", None,
)
_cookie = None


def _playerctl(*args):
    try:
        return subprocess.run(
            ["playerctl", *args], capture_output=True, text=True, timeout=3
        ).stdout
    except Exception:
        return ""


def video_playing() -> bool:
    for name in _playerctl("-l").split():
        if name.split(".")[0].lower() in AUDIO_ONLY:
            continue
        if _playerctl("-p", name, "status").strip() == "Playing":
            return True
    return False


def tick():
    global _cookie
    try:
        playing = video_playing()
        if playing and _cookie is None:
            # PyGObject unwraps single-value returns: this is a plain uint32,
            # not a tuple. Subscripting it was the original stuck-lock bug.
            result = _ss.Inhibit("(ss)", "video-idle-inhibit", "playing video")
            _cookie = result[0] if isinstance(result, tuple) else result
        elif not playing and _cookie is not None:
            try:
                _ss.UnInhibit("(u)", _cookie)
            except Exception:
                pass
            _cookie = None
    except Exception as e:
        # An escaped exception removes the GLib timer but leaves the process
        # (and any held inhibit) alive forever -> screen never locks again.
        # Fail toward releasing: one early lock beats none ever.
        if _cookie is not None:
            try:
                _ss.UnInhibit("(u)", _cookie)
            except Exception:
                pass
            _cookie = None
        print(f"tick error (recovered): {e}", flush=True)
    return True  # keep the GLib timer alive


def main():
    tick()  # act immediately on start
    GLib.timeout_add_seconds(POLL_SECONDS, tick)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
